{
  "name": "bakesbymom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "lint": "eslint .",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 execute bakesbymom --remote --file=./db/schema.sql",
    "db:migrate:local": "wrangler d1 execute bakesbymom --local --file=./db/schema.sql"
  },
  "dependencies": {
    "@types/three": "^0.185.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vite": "^5.4.8",
    "wrangler": "^4.33.1"
  }
}
