# Copy this file to ".env" and fill in your own values.

# Where the catalog API lives. Leave this unset when the site is deployed to
# Cloudflare Workers (`npx wrangler deploy`) — the SPA and the API share one
# origin, so same-origin "/api" is the right default.
#
# Set it only when the frontend is hosted somewhere else (e.g. Vercel) and has
# to reach the Worker cross-origin:
# VITE_API_BASE_URL=https://bakesbymom.<your-subdomain>.workers.dev/api

# Password for the footer "Admin" panel. It is sent to the Worker with every
# write and must match the Worker's ADMIN_PASSWORD secret:
#   npx wrangler secret put ADMIN_PASSWORD
VITE_ADMIN_PASSWORD=bakesbymom

# The bakery's WhatsApp number in international form — country code first, no
# spaces, plus or dashes (e.g. 919812345678). The assistant's order slip opens
# https://wa.me/<number> with the message sitting in the typing box; the
# customer still presses send themselves. Leave it unset and WhatsApp asks
# which chat to open instead.
VITE_WHATSAPP_NUMBER=
